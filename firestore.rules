rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // メールは大文字・小文字を区別しない（2026-10-22 L6）。許可メール・店舗管理者メールの文書IDは小文字で保存している。
    // スーパー管理者のメールは src/lib/ownerIdentity.js・functions/orderCommandAuth.js と同じ（scripts/check-cancel-passcode.mjs で一致を確かめる）。
    function authEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function isSuper() {
      return request.auth != null && authEmail() == 'tsk.mons@gmail.com';
    }

    function isGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAllowedOwner() {
      return isGoogle()
        && exists(/databases/$(database)/documents/allowedEmails/$(authEmail()));
    }

    function isStoreAdminEmail(storeId) {
      return isGoogle()
        && exists(/databases/$(database)/documents/storeAdminEmails/$(authEmail()))
        && get(/databases/$(database)/documents/storeAdminEmails/$(authEmail())).data.storeId == storeId;
    }

    function isOwnerOf(storeId) {
      return isGoogle()
        && request.auth.uid == storeId
        && (
          !exists(/databases/$(database)/documents/stores/$(storeId))
          || string(get(/databases/$(database)/documents/stores/$(storeId)).data.get('ownerEmail', authEmail())).lower() == authEmail()
        );
    }

    function isStaffOf(storeId) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && exists(/databases/$(database)/documents/staffSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.storeId == storeId;
    }

    // お客様の端末（見えないログイン）が、この注文の席にいると Functions が記録したか（customerSessions）。
    function isCustomerOfOrder(orderId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/customerSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/customerSessions/$(request.auth.uid)).data.orderId == orderId;
    }

    function canAccess(storeId) {
      return isSuper() || isOwnerOf(storeId) || isStoreAdminEmail(storeId) || isStaffOf(storeId);
    }

    function canManageStore(storeId) {
      return isSuper() || isOwnerOf(storeId) || isStoreAdminEmail(storeId);
    }

    function currentStaffSessionData() {
      return get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data;
    }

    function canonicalStaffMemberExists(storeId) {
      return isStaffOf(storeId)
        && currentStaffSessionData().get('staffMemberId', null) is string
        && currentStaffSessionData().staffMemberId.size() > 0
        && exists(/databases/$(database)/documents/staffMembers/$(currentStaffSessionData().staffMemberId))
        && get(/databases/$(database)/documents/staffMembers/$(currentStaffSessionData().staffMemberId)).data.storeId == storeId
        // 4桁パスをサーバーで照合した記録だけを信じる（activateStaffSessionCommand が書く。2026-10-22 第4章 4-B）。
        && currentStaffSessionData().get('verifiedStaffMemberId', null) == currentStaffSessionData().staffMemberId;
    }

    function currentStaffMemberData() {
      return get(/databases/$(database)/documents/staffMembers/$(currentStaffSessionData().staffMemberId)).data;
    }

    function presetPermissionDefault(preset, permission, legacyDefault) {
      return legacyDefault == true
        || preset == 'manager'
        || (
          (
            preset == 'operations'
            || !(preset in ['manager', 'operations', 'menuLead', 'floor', 'custom', 'legacy', ''])
          )
          && permission in ['useKitchen', 'closeRegister', 'manageTables', 'manageReservations']
        )
        || (preset == 'menuLead' && permission in ['useKitchen', 'manageMenu'])
        || (preset in ['floor', 'custom', 'legacy', ''] && permission == 'useKitchen');
    }

    function canonicalStaffPreset(memberData) {
      return memberData.get('permissionPreset', null) is string
        ? memberData.permissionPreset
        : 'legacy';
    }

    function canonicalStaffPermission(memberData, permission, legacyDefault) {
      return memberData.get('permissions', {}).get(permission, null) is bool
        ? memberData.get('permissions', {}).get(permission, false)
        : presetPermissionDefault(canonicalStaffPreset(memberData), permission, legacyDefault);
    }

    // 個別の ON/OFF があればそれを守り、無いときだけ権限の型の既定値を使う（画面の staffPermissions.js と同じ。2026-10-22 L5）。
    function staffPermission(storeId, permission, legacyDefault) {
      return canonicalStaffMemberExists(storeId)
        && canonicalStaffPermission(currentStaffMemberData(), permission, legacyDefault) == true;
    }

    function canManageMenu(storeId) {
      return canManageStore(storeId) || staffPermission(storeId, 'manageMenu', false);
    }

    function canCloseRegister(storeId) {
      return canManageStore(storeId) || staffPermission(storeId, 'closeRegister', false);
    }

    function canManageStaff(storeId) {
      return canManageStore(storeId) || staffPermission(storeId, 'manageStaff', false);
    }

    function canManageTables(storeId) {
      return canManageStore(storeId) || staffPermission(storeId, 'manageTables', false);
    }

    function canManageReservations(storeId) {
      return canManageStore(storeId) || staffPermission(storeId, 'manageReservations', false);
    }

    function canViewHistory(storeId) {
      return canManageStore(storeId) || staffPermission(storeId, 'viewHistory', false);
    }

    function canManageSettings(storeId) {
      return canManageStore(storeId) || staffPermission(storeId, 'manageSettings', false);
    }

    function keepsTableManagementFields() {
      return request.resource.data.storeId == resource.data.storeId
        && request.resource.data.tableName == resource.data.tableName
        && request.resource.data.get('qrToken', null) == resource.data.get('qrToken', null)
        && request.resource.data.get('sortOrder', null) == resource.data.get('sortOrder', null);
    }

    function canHandleReservationWait() {
      return canAccess(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId
        && resource.data.status == 'confirmed'
        && resource.data.get('waitingStatus', 'none') == 'pending'
        && request.resource.data.status in ['confirmed', 'seated']
        && request.resource.data.get('waitingStatus', 'none') in ['handled', 'dismissed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'waitingStatus',
          'waitingReason',
          'seatedTableId',
          'seatedOrderId',
          'handledAt',
          'handledByStaffId',
          'handledByStaffName',
          'dismissedAt',
          'updatedAt'
        ]);
    }

    function validOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validStaffSessionBase(data) {
      return data.storeId is string
        && data.storeId.size() > 0
        && data.storeId.size() <= 128
        && data.code is string
        && data.code.size() > 0
        && data.code.size() <= 64
        && exists(/databases/$(database)/documents/storeCodes/$(data.code))
        && get(/databases/$(database)/documents/storeCodes/$(data.code)).data.storeId == data.storeId;
    }

    function validStaffSessionEntry(data) {
      return data.keys().hasOnly(['storeId', 'code'])
        && data.keys().hasAll(['storeId', 'code'])
        && validStaffSessionBase(data);
    }

    function validSalesAuditFieldTypes(data, prefix) {
      return validOptionalString(data.get(prefix + 'ByUid', null), 128)
        && validOptionalString(data.get(prefix + 'ByEmail', null), 320)
        && validOptionalString(data.get(prefix + 'ByStaffId', null), 128)
        && validOptionalString(data.get(prefix + 'ByStaffName', null), 120);
    }

    function hasSalesAuditFields(data) {
      return data.keys().hasAll([
        'createdByUid',
        'createdByEmail',
        'createdByStaffId',
        'createdByStaffName',
        'updatedByUid',
        'updatedByEmail',
        'updatedByStaffId',
        'updatedByStaffName'
      ]);
    }

    function validSalesStaffActorFields(data, prefix) {
      let session = currentStaffSessionData();
      let member = get(/databases/$(database)/documents/staffMembers/$(session.staffMemberId)).data;
      return data.get(prefix + 'ByEmail', null) == null
        && data.get(prefix + 'ByStaffId', null) == session.staffMemberId
        && data.get(prefix + 'ByStaffName', null) == member.name;
    }

    function validSalesAdminActorFields(data, prefix) {
      return data.get(prefix + 'ByEmail', null) == request.auth.token.email
        && data.get(prefix + 'ByStaffId', null) == null
        && data.get(prefix + 'ByStaffName', null) == null;
    }

    // 呼び出し元のcanManageStaff/canCloseRegisterで店舗とcanonical権限を検証済み。
    function validSalesActorFields(data, prefix) {
      return request.auth != null
        && data.get(prefix + 'ByUid', null) == request.auth.uid
        && (
          (
            request.auth.token.firebase.sign_in_provider == 'anonymous'
            && validSalesStaffActorFields(data, prefix)
          )
          || (
            request.auth.token.firebase.sign_in_provider != 'anonymous'
            && validSalesAdminActorFields(data, prefix)
          )
        );
    }

    function sameSalesActorFields(data, firstPrefix, secondPrefix) {
      return data.get(firstPrefix + 'ByUid', null) == data.get(secondPrefix + 'ByUid', null)
        && data.get(firstPrefix + 'ByEmail', null) == data.get(secondPrefix + 'ByEmail', null)
        && data.get(firstPrefix + 'ByStaffId', null) == data.get(secondPrefix + 'ByStaffId', null)
        && data.get(firstPrefix + 'ByStaffName', null) == data.get(secondPrefix + 'ByStaffName', null);
    }

    function validSalesStaffActionActor(data) {
      let session = currentStaffSessionData();
      let member = get(/databases/$(database)/documents/staffMembers/$(session.staffMemberId)).data;
      return data.actorType == 'staff'
        && data.actorEmail == null
        && data.actorStaffId == session.staffMemberId
        && data.actorStaffName == member.name;
    }

    function validSalesAdminActionActor(data) {
      return data.actorType == 'admin'
        && data.actorEmail == request.auth.token.email
        && data.actorStaffId == null
        && data.actorStaffName == null;
    }

    // 呼び出し元の権限判定を通過したactorだけをcanonical情報と照合する。
    function validSalesActionActor(data) {
      return request.auth != null
        && data.actorUid == request.auth.uid
        && (
          (
            request.auth.token.firebase.sign_in_provider == 'anonymous'
            && validSalesStaffActionActor(data)
          )
          || (
            request.auth.token.firebase.sign_in_provider != 'anonymous'
            && validSalesAdminActionActor(data)
          )
        );
    }

    function validSalesActionCommon(data) {
      return data.note is string
        && data.note.size() > 0
        && data.note.size() <= 500
        && data.createdAt == request.time
        && validOptionalString(data.actorUid, 128)
        && validOptionalString(data.actorEmail, 320)
        && validOptionalString(data.actorStaffId, 128)
        && validOptionalString(data.actorStaffName, 120)
        && validSalesActionActor(data);
    }

    function validSalesAssigneeActionData(data) {
      return data.keys().hasOnly([
          'storeId',
          'actionType',
          'changeType',
          'targetType',
          'targetId',
          'actorType',
          'actorStaffId',
          'actorStaffName',
          'actorUid',
          'actorEmail',
          'assigneeId',
          'assigneeName',
          'previousAssigneeName',
          'isActive',
          'note',
          'createdAt'
        ])
        && data.actionType == 'sales_assignee'
        && data.changeType in ['create', 'rename', 'deactivate', 'reactivate']
        && data.targetType == 'salesAssignee'
        && data.targetId is string
        && data.targetId.size() > 0
        && data.targetId.size() <= 128
        && data.assigneeId == data.targetId
        && data.assigneeName is string
        && data.assigneeName.size() > 0
        && data.assigneeName.size() <= 80
        && validOptionalString(data.previousAssigneeName, 80)
        && data.isActive is bool
        && validSalesActionCommon(data);
    }

    function validSalesAttributionActionData(data) {
      return data.keys().hasOnly([
          'storeId',
          'actionType',
          'changeType',
          'targetType',
          'targetId',
          'actorType',
          'actorStaffId',
          'actorStaffName',
          'actorUid',
          'actorEmail',
          'checkId',
          'previousAssigneeId',
          'previousAssigneeName',
          'assigneeId',
          'assigneeName',
          'note',
          'createdAt'
        ])
        && data.actionType == 'sales_attribution'
        && data.changeType in ['set', 'change', 'clear']
        && data.targetType == 'check'
        && data.targetId is string
        && data.targetId.size() > 0
        && data.targetId.size() <= 128
        && data.checkId == data.targetId
        && validOptionalString(data.previousAssigneeId, 128)
        && validOptionalString(data.previousAssigneeName, 80)
        && validOptionalString(data.assigneeId, 128)
        && validOptionalString(data.assigneeName, 80)
        && validSalesActionCommon(data);
    }

    function validSalesAssigneeData(data) {
      return data.keys().hasOnly([
          'storeId',
          'name',
          'isActive',
          'createdAt',
          'createdByUid',
          'createdByEmail',
          'createdByStaffId',
          'createdByStaffName',
          'updatedAt',
          'updatedByUid',
          'updatedByEmail',
          'updatedByStaffId',
          'updatedByStaffName',
          'lastAuditActionId'
        ])
        && hasSalesAuditFields(data)
        && data.storeId is string
        && data.storeId.size() > 0
        && data.storeId.size() <= 128
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.isActive is bool
        && data.lastAuditActionId is string
        && data.lastAuditActionId.size() > 0
        && data.lastAuditActionId.size() <= 128;
    }

    function validAssignedSalesAttribution(data) {
      let assignee = get(/databases/$(database)/documents/salesAssignees/$(data.assigneeId)).data;
      return exists(/databases/$(database)/documents/salesAssignees/$(data.assigneeId))
        && assignee.storeId == data.storeId
        && assignee.isActive == true
        && assignee.name == data.assigneeNameSnapshot;
    }

    function validSalesAttributionSelection(data) {
      return (
          data.status == 'unassigned'
          && data.assigneeId == null
          && data.assigneeNameSnapshot == null
        ) || (
          data.status == 'assigned'
          && data.assigneeId is string
          && data.assigneeId.size() > 0
          && data.assigneeId.size() <= 128
          && data.assigneeNameSnapshot is string
          && data.assigneeNameSnapshot.size() > 0
          && data.assigneeNameSnapshot.size() <= 80
          && validAssignedSalesAttribution(data)
        );
    }

    function validCompletedSalesCheck(data, checkId) {
      let check = get(/databases/$(database)/documents/checks/$(checkId)).data;
      return exists(/databases/$(database)/documents/checks/$(checkId))
        && check.storeId == data.storeId
        && check.status == 'completed';
    }

    function validSalesAttributionData(data, checkId) {
      return data.keys().hasOnly([
          'storeId',
          'checkId',
          'status',
          'assigneeId',
          'assigneeNameSnapshot',
          'createdAt',
          'createdByUid',
          'createdByEmail',
          'createdByStaffId',
          'createdByStaffName',
          'updatedAt',
          'updatedByUid',
          'updatedByEmail',
          'updatedByStaffId',
          'updatedByStaffName',
          'lastAuditActionId'
        ])
        && hasSalesAuditFields(data)
        && data.storeId is string
        && data.storeId.size() > 0
        && data.storeId.size() <= 128
        && data.checkId == checkId
        && validCompletedSalesCheck(data, checkId)
        && validSalesAttributionSelection(data)
        && data.lastAuditActionId is string
        && data.lastAuditActionId.size() > 0
        && data.lastAuditActionId.size() <= 128;
    }

    function salesAuditActionData(actionId) {
      return getAfter(/databases/$(database)/documents/staffActions/$(actionId)).data;
    }

    function validSalesAssigneeCreateAudit(data, assigneeId) {
      let action = salesAuditActionData(data.lastAuditActionId);
      return existsAfter(/databases/$(database)/documents/staffActions/$(data.lastAuditActionId))
        && action.actionType == 'sales_assignee'
        && action.targetType == 'salesAssignee'
        && action.createdAt == request.time
        && action.storeId == data.storeId
        && action.changeType == 'create'
        && action.targetId == assigneeId
        && action.assigneeId == assigneeId
        && action.assigneeName == data.name
        && action.previousAssigneeName == null
        && action.isActive == true;
    }

    function validSalesAssigneeUpdateAudit(data, previousData, assigneeId) {
      let action = salesAuditActionData(data.lastAuditActionId);
      return data.lastAuditActionId != previousData.lastAuditActionId
        && existsAfter(/databases/$(database)/documents/staffActions/$(data.lastAuditActionId))
        && action.actionType == 'sales_assignee'
        && action.targetType == 'salesAssignee'
        && action.createdAt == request.time
        && action.storeId == data.storeId
        && action.targetId == assigneeId
        && action.assigneeId == assigneeId
        && action.previousAssigneeName == previousData.name
        && action.assigneeName == data.name
        && action.isActive == data.isActive
        && (
          (
            data.isActive != previousData.isActive
            && data.name == previousData.name
            && (
              (data.isActive == true && action.changeType == 'reactivate')
              || (data.isActive == false && action.changeType == 'deactivate')
            )
          )
          || (
            data.isActive == previousData.isActive
            && data.name != previousData.name
            && action.changeType == 'rename'
          )
        );
    }

    function validSalesAttributionCreateAudit(data, checkId) {
      let action = salesAuditActionData(data.lastAuditActionId);
      return data.status == 'assigned'
        && existsAfter(/databases/$(database)/documents/staffActions/$(data.lastAuditActionId))
        && action.actionType == 'sales_attribution'
        && action.targetType == 'check'
        && action.createdAt == request.time
        && action.storeId == data.storeId
        && action.changeType == 'set'
        && action.targetId == checkId
        && action.checkId == checkId
        && action.previousAssigneeId == null
        && action.previousAssigneeName == null
        && action.assigneeId == data.assigneeId
        && action.assigneeName == data.assigneeNameSnapshot;
    }

    function validSalesAttributionUpdateAudit(data, previousData, checkId) {
      let action = salesAuditActionData(data.lastAuditActionId);
      return data.lastAuditActionId != previousData.lastAuditActionId
        && (data.status != previousData.status || data.assigneeId != previousData.assigneeId)
        && existsAfter(/databases/$(database)/documents/staffActions/$(data.lastAuditActionId))
        && action.actionType == 'sales_attribution'
        && action.targetType == 'check'
        && action.createdAt == request.time
        && action.storeId == data.storeId
        && action.targetId == checkId
        && action.checkId == checkId
        && action.previousAssigneeId == previousData.assigneeId
        && action.previousAssigneeName == previousData.assigneeNameSnapshot
        && action.assigneeId == data.assigneeId
        && action.assigneeName == data.assigneeNameSnapshot
        && (
          (data.status == 'unassigned' && action.changeType == 'clear')
          || (
            data.status == 'assigned'
            && previousData.status == 'assigned'
            && action.changeType == 'change'
          )
          || (
            data.status == 'assigned'
            && previousData.status == 'unassigned'
            && action.changeType == 'set'
          )
        );
    }

    function validSalesAssigneeActionBackLink(data, actionId) {
      let assignee = getAfter(/databases/$(database)/documents/salesAssignees/$(data.targetId)).data;
      return existsAfter(/databases/$(database)/documents/salesAssignees/$(data.targetId))
        && assignee.storeId == data.storeId
        && assignee.lastAuditActionId == actionId;
    }

    function validSalesAttributionActionBackLink(data, actionId) {
      let attribution = getAfter(/databases/$(database)/documents/salesAttributions/$(data.checkId)).data;
      return existsAfter(/databases/$(database)/documents/salesAttributions/$(data.checkId))
        && attribution.storeId == data.storeId
        && attribution.lastAuditActionId == actionId;
    }

    function validOrderCommandFailure() {
      return request.resource.data.keys().hasOnly([
          'commandType',
          'actorType',
          'storeId',
          'tableId',
          'targetTableId',
          'orderId',
          'itemId',
          'clientRequestId',
          'errorCode',
          'errorName',
          'errorMessage',
          'orderCommandVersion',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'commandType',
          'actorType',
          'errorCode',
          'errorName',
          'errorMessage',
          'orderCommandVersion',
          'createdAt'
        ])
        && request.resource.data.commandType is string
        && request.resource.data.commandType.size() > 0
        && request.resource.data.commandType.size() <= 120
        && request.resource.data.actorType is string
        && request.resource.data.actorType.size() > 0
        && request.resource.data.actorType.size() <= 48
        && validOptionalString(request.resource.data.get('storeId', null), 128)
        && validOptionalString(request.resource.data.get('tableId', null), 128)
        && validOptionalString(request.resource.data.get('targetTableId', null), 128)
        && validOptionalString(request.resource.data.get('orderId', null), 128)
        && validOptionalString(request.resource.data.get('itemId', null), 128)
        && validOptionalString(request.resource.data.get('clientRequestId', null), 160)
        && request.resource.data.errorCode is string
        && request.resource.data.errorCode.size() > 0
        && request.resource.data.errorCode.size() <= 120
        && request.resource.data.errorName is string
        && request.resource.data.errorName.size() > 0
        && request.resource.data.errorName.size() <= 120
        && request.resource.data.errorMessage is string
        && request.resource.data.errorMessage.size() > 0
        && request.resource.data.errorMessage.size() <= 500
        && request.resource.data.orderCommandVersion is number
        && request.resource.data.createdAt == request.time;
    }

    // 許可メール（オーナーが管理）
    match /allowedEmails/{email} {
      allow read: if isSuper() || (isGoogle() && authEmail() == email);
      allow write: if isSuper();
    }

    match /storeAdminEmails/{email} {
      allow read: if isSuper() || (isGoogle() && authEmail() == email);
      allow write: if isSuper();
    }

    // スタッフセッション（匿名ユーザーを店舗に紐づける）
    match /staffSessions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && validStaffSessionEntry(request.resource.data);
      // スタッフの選択（staffMemberId）を書けるのは activateStaffSessionCommand だけ。端末は店舗コードの入り直しだけ。
      allow update: if request.auth != null
        && request.auth.uid == uid
        && validStaffSessionEntry(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 店舗コード
    match /storeCodes/{code} {
      allow read: if request.auth != null;
      // 店舗コードは createStoreCommand（Functions）が重複を確かめて作る。画面からは書けない（2026-10-22 店舗登録）。
      allow write: if false;
    }

    // 店舗
    match /stores/{storeId} {
      allow read: if canAccess(storeId);
      // 店舗は createStoreCommand（Functions）だけが作る（2026-10-22 店舗登録）。
      allow create: if false;
      // 取消パスコードの設定状況・店舗コード・店長の招待は Functions だけが書く。
      allow update: if canManageStore(storeId)
        && request.resource.data.get('cancelPasscodeStatus', null) == resource.data.get('cancelPasscodeStatus', null)
        && request.resource.data.get('storeCode', null) == resource.data.get('storeCode', null)
        && request.resource.data.get('managerInviteId', null) == resource.data.get('managerInviteId', null);
      allow delete: if canManageStore(storeId);
    }

    // 店長用の招待（秘密の値のハッシュ）。Functions だけが読み書きする（2026-10-22 店舗登録）。
    match /storeInvites/{inviteId} {
      allow read, write: if false;
    }

    // 取消パスコードのハッシュ。照合は Functions だけが行うので、画面からは読み書きさせない。
    match /storeSecrets/{storeId} {
      allow read, write: if false;
    }

    // スタッフの4桁パスのハッシュ。照合・登録・変更は Functions だけ（2026-10-22 第4章 4-B）。
    match /staffSecrets/{memberId} {
      allow read, write: if false;
    }

    // テーブル。お客様は入口の記録（tableEntries）で知った席を1件ずつ読む（get）。
    // 一覧（list）は店の人だけ（2026-10-28 QR 第1章。店の外から全部の席のQRを集められないように）。
    match /tables/{tableId} {
      allow get: if true;
      allow list: if canAccess(resource.data.storeId);
      allow create: if canManageTables(request.resource.data.storeId);
      allow update: if canManageTables(resource.data.storeId)
                    || (canAccess(resource.data.storeId) && keepsTableManagementFields());
      // 消せるのは空いていて注文の無い席だけ（2026-10-23 席設計）。履歴・売上の画面は席の名前を使っていない。
      allow delete: if canManageTables(resource.data.storeId)
                    && resource.data.get('status', 'vacant') == 'vacant'
                    && resource.data.get('currentOrderId', null) == null;
    }
    // QRの入口（2026-10-28 QR 第1章）。名前がQRの文字。QRを持っている人がその1件だけ読める（一覧は不可）。
    // 作れるのは席を管理できる人だけ。席を1件ずつ確かめる読み込み（getAfter）は、まとめて追加で上限（20回）に当たるので使わない。
    // 入口が別の店の席を指していても、お客様の画面は店が一致しないと入れない（customerEntryService）。
    match /tableEntries/{qrToken} {
      allow get: if true;
      allow list, update: if false;
      allow create: if canManageTables(request.resource.data.storeId)
                    && request.resource.data.tableId is string
                    && request.resource.data.keys().hasOnly(['storeId', 'tableId', 'createdAt']);
      // 入口がまだ無い古い席でも、席を消す・QRを作り直す書き込みが止まらないよう、無いものを消すのは通す（何も起きない）。
      allow delete: if resource == null || canManageTables(resource.data.storeId);
    }

    // 席のQRの文字（2026-10-29 QR 第2章）。お客様も読める席の記録には置かず、店の人だけが読める。
    match /tableSecrets/{tableId} {
      allow read: if canAccess(resource.data.storeId);
      allow create, update: if canManageTables(request.resource.data.storeId);
      allow delete: if resource == null || canManageTables(resource.data.storeId);
    }

    // この端末はこの注文（2026-10-29 QR 第2章）。書くのは Functions だけ。本人だけが読める。
    match /customerSessions/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // 席グループ（tableGroups）は 2026-10-23 席設計で無くした。決まりが無いので読み書きできない。

    // カテゴリー（お客さんも読める）
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if canManageMenu(request.resource.data.storeId);
      allow update, delete: if canManageMenu(resource.data.storeId);
    }

    // 商品（お客さんも読める）
    match /products/{productId} {
      allow read: if true;
      allow create: if canManageMenu(request.resource.data.storeId);
      allow update, delete: if canManageMenu(resource.data.storeId);
    }

    // オプションテンプレート
    match /optionTemplates/{templateId} {
      allow read: if canAccess(resource.data.storeId);
      allow create: if canManageMenu(request.resource.data.storeId);
      allow update, delete: if canManageMenu(resource.data.storeId);
    }

    // タグテンプレート
    match /tagTemplates/{templateId} {
      allow read: if canAccess(resource.data.storeId);
      allow create: if canManageMenu(request.resource.data.storeId);
      allow update, delete: if canManageMenu(resource.data.storeId);
    }

    // 注文（作成は Cloud Functions のコマンドだけ）
    // 書き換え・削除も Cloud Functions だけ（2026-10-22 整理 第4章 K7。画面から直接書く予備は廃止済み）。
    // 読めるのは店の人だけ（2026-10-29 QR 第2章。前は誰でも全部の店の注文を読めた）。お客様の画面は注文を読まない。
    match /orders/{orderId} {
      allow read: if canAccess(resource.data.storeId);
      allow create, update, delete: if false;
    }

    // 注文アイテム（作成は Cloud Functions のコマンドだけ）
    // 読めるのは店の人と、「この端末はこの注文」と記録されたお客様だけ（2026-10-29 QR 第2章）。
    // お客様の画面は orderId で絞って読むので、記録の注文と一致する品だけが返る。
    match /orderItems/{itemId} {
      allow read: if canAccess(resource.data.storeId) || isCustomerOfOrder(resource.data.orderId);
      allow create, update, delete: if false;
    }

    // 会計
    match /checks/{checkId} {
      allow read: if canCloseRegister(resource.data.storeId) || canViewHistory(resource.data.storeId);
      // 会計の作成は completeCheckoutCommand（Functions）だけ。
      allow create, update, delete: if false;
    }

    // レジ締め
    match /cashClosings/{closingId} {
      allow read: if canCloseRegister(resource.data.storeId);
      allow create: if canCloseRegister(request.resource.data.storeId);
      allow update, delete: if canCloseRegister(resource.data.storeId);
    }

    // 売上担当マスタ（無効化で履歴を保持し、物理削除しない）
    match /salesAssignees/{assigneeId} {
      allow read: if canCloseRegister(resource.data.storeId) || canManageStaff(resource.data.storeId);
      allow create: if canManageStaff(request.resource.data.storeId)
        && validSalesAssigneeData(request.resource.data)
        && validSalesAuditFieldTypes(request.resource.data, 'created')
        && validSalesActorFields(request.resource.data, 'created')
        && sameSalesActorFields(request.resource.data, 'created', 'updated')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validSalesAssigneeCreateAudit(request.resource.data, assigneeId);
      allow update: if canManageStaff(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId
        && validSalesAssigneeData(request.resource.data)
        && validSalesAuditFieldTypes(request.resource.data, 'created')
        && validSalesAuditFieldTypes(request.resource.data, 'updated')
        && validSalesActorFields(request.resource.data, 'updated')
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && request.resource.data.get('createdByEmail', null) == resource.data.get('createdByEmail', null)
        && request.resource.data.get('createdByStaffId', null) == resource.data.get('createdByStaffId', null)
        && request.resource.data.get('createdByStaffName', null) == resource.data.get('createdByStaffName', null)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'isActive',
          'updatedAt',
          'updatedByUid',
          'updatedByEmail',
          'updatedByStaffId',
          'updatedByStaffName',
          'lastAuditActionId'
        ])
        && validSalesAssigneeUpdateAudit(request.resource.data, resource.data, assigneeId);
      allow delete: if false;
    }

    // 会計ごとの担当（ドキュメントIDをcheckIdに固定し、1会計1担当にする）
    match /salesAttributions/{checkId} {
      allow get: if exists(/databases/$(database)/documents/checks/$(checkId))
        && canCloseRegister(get(/databases/$(database)/documents/checks/$(checkId)).data.storeId);
      allow list: if canCloseRegister(resource.data.storeId);
      allow create: if canCloseRegister(request.resource.data.storeId)
        && validSalesAttributionData(request.resource.data, checkId)
        && validSalesAuditFieldTypes(request.resource.data, 'created')
        && validSalesActorFields(request.resource.data, 'created')
        && sameSalesActorFields(request.resource.data, 'created', 'updated')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validSalesAttributionCreateAudit(request.resource.data, checkId);
      allow update: if canCloseRegister(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.checkId == resource.data.checkId
        && validSalesAttributionData(request.resource.data, checkId)
        && validSalesAuditFieldTypes(request.resource.data, 'created')
        && validSalesAuditFieldTypes(request.resource.data, 'updated')
        && validSalesActorFields(request.resource.data, 'updated')
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
        && request.resource.data.get('createdByEmail', null) == resource.data.get('createdByEmail', null)
        && request.resource.data.get('createdByStaffId', null) == resource.data.get('createdByStaffId', null)
        && request.resource.data.get('createdByStaffName', null) == resource.data.get('createdByStaffName', null)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'assigneeId',
          'assigneeNameSnapshot',
          'updatedAt',
          'updatedByUid',
          'updatedByEmail',
          'updatedByStaffId',
          'updatedByStaffName',
          'lastAuditActionId'
        ])
        && validSalesAttributionUpdateAudit(request.resource.data, resource.data, checkId);
      allow delete: if false;
    }

    // スタッフアクション
    match /staffActions/{actionId} {
      allow read: if canViewHistory(resource.data.storeId);
      allow create: if (
          request.resource.data.get('actionType', '') == 'sales_assignee'
          && canManageStaff(request.resource.data.storeId)
          && validSalesAssigneeActionData(request.resource.data)
          && validSalesAssigneeActionBackLink(request.resource.data, actionId)
        ) || (
          request.resource.data.get('actionType', '') == 'sales_attribution'
          && canCloseRegister(request.resource.data.storeId)
          && validSalesAttributionActionData(request.resource.data)
          && validSalesAttributionActionBackLink(request.resource.data, actionId)
        ) || (
          !(request.resource.data.get('actionType', '') in ['sales_assignee', 'sales_attribution'])
          && canAccess(request.resource.data.storeId)
        );
      allow update: if !(resource.data.get('actionType', '') in ['sales_assignee', 'sales_attribution'])
        && !(request.resource.data.get('actionType', '') in ['sales_assignee', 'sales_attribution'])
        && canAccess(resource.data.storeId);
      allow delete: if !(resource.data.get('actionType', '') in ['sales_assignee', 'sales_attribution'])
        && canAccess(resource.data.storeId);
    }

    // 注文コマンド失敗ログ
    match /orderCommandFailures/{failureId} {
      allow read: if isSuper()
        || (
          resource.data.storeId is string
          && resource.data.storeId.size() > 0
          && canViewHistory(resource.data.storeId)
        );
      allow create: if validOrderCommandFailure();
      allow update, delete: if isSuper()
        || (
          resource.data.storeId is string
          && resource.data.storeId.size() > 0
          && canManageStore(resource.data.storeId)
        );
    }

    // 予約
    match /reservations/{reservationId} {
      allow read: if canAccess(resource.data.storeId);
      allow create: if canManageReservations(request.resource.data.storeId);
      allow update: if canManageReservations(resource.data.storeId) || canHandleReservationWait();
      allow delete: if canManageReservations(resource.data.storeId);
    }

    // 店舗設定（お客さんも読める）
    match /storeConfig/{configId} {
      allow read: if true;
      allow write: if canManageSettings(configId);
    }

    // スタッフメンバー
    match /staffMembers/{memberId} {
      allow read: if canAccess(resource.data.storeId);
      // 追加はパスと一緒に createStaffMemberCommand で。パス（code）は画面から書けない（2026-10-22 第4章 4-B）。
      allow create: if false;
      allow update: if canManageStaff(resource.data.storeId)
        && request.resource.data.storeId == resource.data.storeId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['code']);
      allow delete: if canManageStaff(resource.data.storeId);
    }

    // 呼び出し（お客さんも作成できる）
    match /calls/{callId} {
      allow read: if canAccess(resource.data.storeId);
      allow create: if true;
      allow update: if canAccess(resource.data.storeId);
      allow delete: if canAccess(resource.data.storeId);
    }

    // スタッフトークン
    match /staffTokens/{tokenId} {
      allow read: if canAccess(resource.data.storeId);
      allow create: if canAccess(request.resource.data.storeId);
      allow update, delete: if canAccess(resource.data.storeId);
    }
  }
}
